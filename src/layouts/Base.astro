---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { seriesUrl, type Locale } from '../lib/posts';
import { SERIES, seriesTitle } from '../lib/series';
import SocialLinks from '../components/SocialLinks.astro';
interface Props { title?: string; description?: string; lang?: Locale; alternate?: string; og?: string; article?: boolean; }
const { title = 'Asaki', description = 'Asaki 的博客', lang = 'zh', alternate, og, article = false } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title === 'Asaki' ? title : `${title} · Asaki`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href="/fonts/jinkai.css" />
    <link rel="alternate" type="application/rss+xml" title={lang === 'en' ? 'Asaki in English' : 'Asaki 中文'} href={`${prefix}/rss.xml`} />
    {alternate && <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={new URL(alternate, Astro.site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {og && <meta property="og:image" content={new URL(og, Astro.site)} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      (() => {
        const dark = matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          let saved = null;
          try { saved = localStorage.getItem('theme'); } catch {}
          const theme = saved === 'light' || saved === 'dark' ? saved : dark.matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
          document.querySelectorAll('.theme-toggle').forEach(button => button.setAttribute('aria-pressed', String(theme === 'dark')));
        };
        apply();
        // The client router replaces <html> attributes on navigation, and this script only registers once.
        if (window.__applyTheme) return;
        window.__applyTheme = apply;
        dark.addEventListener('change', apply);
        document.addEventListener('astro:after-swap', apply);
        document.addEventListener('DOMContentLoaded', apply);
        const setMenu = open => {
          document.querySelector('.nav-more')?.setAttribute('aria-expanded', String(open));
          document.getElementById('nav-extra')?.toggleAttribute('data-open', open);
        };
        document.addEventListener('click', event => {
          if (!(event.target instanceof Element)) return;
          if (event.target.closest('.nav-more')) return setMenu(!document.getElementById('nav-extra')?.hasAttribute('data-open'));
          if (!event.target.closest('#nav-extra')) setMenu(false);
          if (!event.target.closest('.theme-toggle')) return;
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('theme', next); } catch {}
          apply();
        });
        document.addEventListener('keydown', event => {
          if (event.key !== 'Escape' || !document.getElementById('nav-extra')?.hasAttribute('data-open')) return;
          setMenu(false);
          document.querySelector('.nav-more')?.focus();
        });
      })();
    </script>
    <ClientRouter fallback="none" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <header class="site-header"><nav aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
      <a class="brand" href={`${prefix}/`}>Asaki</a>
      {SERIES.map(name => <a href={seriesUrl(name, lang)}>{seriesTitle(name, lang)}</a>)}
      <span class="nav-space"></span>
      <div class="nav-tools">
        <div class="nav-extra" id="nav-extra">
          {lang === 'en' && <div class="nav-series">{SERIES.map(name => <a href={seriesUrl(name, lang)}>{seriesTitle(name, lang)}</a>)}</div>}
          {alternate && <a class="language" href={alternate} lang={lang === 'zh' ? 'en' : 'zh-CN'} aria-label={lang === 'zh' ? 'Read in English' : '阅读中文'}><span class="language-short">{lang === 'zh' ? 'EN' : '中'}</span><span class="language-long">{lang === 'zh' ? 'Read in English' : '阅读中文'}</span></a>}
          <SocialLinks lang={lang} />
        </div>
        <button class="nav-more" type="button" aria-label={lang === 'zh' ? '更多' : 'More'} aria-expanded="false" aria-controls="nav-extra">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /></svg>
        </button>
        <button class="theme-toggle" type="button" aria-label={lang === 'zh' ? '深色模式' : 'Dark mode'} aria-pressed="false">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
        </button>
      </div>
    </nav></header>
    <main id="main"><slot /></main>
    <footer><a href={`${prefix}/rss.xml`}>RSS</a><span>© {new Date().getFullYear()} Asaki</span></footer>
  </body>
</html>
