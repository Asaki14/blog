{
  "name": "asaki-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "node comments/build.mjs --client",
    "build": "astro build",
    "prebuild": "node comments/build.mjs --client",
    "preview": "astro preview",
    "build:drafts": "SHOW_DRAFTS=1 astro build",
    "prebuild:drafts": "node comments/build.mjs --client",
    "preview:drafts": "npm run build:drafts && SHOW_DRAFTS=1 astro preview",
    "deploy": "npm run build && wrangler deploy",
    "dev:drafts": "SHOW_DRAFTS=1 astro dev --port 4330",
    "predev:drafts": "node comments/build.mjs --client",
    "build:comments": "node comments/build.mjs",
    "deploy:comments": "npm run build:comments && node comments/deploy.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.4",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "0.63.2"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
