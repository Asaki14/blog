{
  "name": "asaki-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:drafts": "SHOW_DRAFTS=1 astro build",
    "preview:drafts": "npm run build:drafts && SHOW_DRAFTS=1 astro preview",
    "deploy": "npm run build && wrangler deploy",
    "dev:drafts": "SHOW_DRAFTS=1 astro dev --port 4330"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.4",
    "satori": "0.63.2"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
